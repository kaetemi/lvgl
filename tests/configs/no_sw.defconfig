# Exercise hardware rendering without the software draw unit or its fallbacks.
# CONFIG_LV_USE_DRAW_SW is not set
# CONFIG_LV_USE_DRAW_SW_COMPLEX_GRADIENTS is not set

# EVE has no vector renderer without the software fallback. The vector API
# requires one, and these features depend on it.
# CONFIG_LV_USE_VECTOR_GRAPHIC is not set
# CONFIG_LV_USE_THORVG is not set
# CONFIG_LV_USE_SVG is not set
# CONFIG_LV_USE_SVG_ANIMATION is not set
# CONFIG_LV_USE_SVG_DEBUG is not set
# CONFIG_LV_USE_LOTTIE is not set
# CONFIG_LV_USE_DEMO_VECTOR_GRAPHIC is not set
