# Render through the EVE5 draw unit and display driver on the EVE HAL. The HAL
# is not part of LVGL: the project that builds the tests links it, see the
# EVE5 section of tests/README.md.

CONFIG_LV_USE_EVE5=y
CONFIG_LV_USE_DRAW_EVE5=y

# The EVE5 goldens (ref_imgs_eve5) are written by lvgl_suite.py update-goldens
# only, not by whichever configuration takes a new screenshot first. A missing
# golden passes, and the report lists the screenshot as new.
# CONFIG_LV_TEST_SCREENSHOT_CREATE_REFERENCE_IMAGE is not set
